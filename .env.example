# Windows launcher: copy to .env in the repository root; literal KEY=value only.
# Manual Maven launch: export the variables in your shell (Spring does not load .env).
DB_URL=jdbc:postgresql://localhost:5432/personalfinance
DB_USERNAME=postgres
DB_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://127.0.0.1:3000
SERVER_PORT=8080

# Frontend (Next.js) — optional; defaults to localhost:8080
# BACKEND_URL=http://127.0.0.1:8080
